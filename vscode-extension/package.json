{
  "name": "tokensqueeze",
  "displayName": "TokenSqueeze",
  "description": "Compress LLM prompts in your editor. SNS rules, LLMLingua-2 (optional), live token counts.",
  "version": "0.1.0",
  "publisher": "tokensqueeze",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tokensqueeze/tokensqueeze.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tokensqueeze.compress",
        "title": "TokenSqueeze: Compress Selection"
      },
      {
        "command": "tokensqueeze.explain",
        "title": "TokenSqueeze: Explain Compression (Side-by-Side)"
      },
      {
        "command": "tokensqueeze.toggleStatusBar",
        "title": "TokenSqueeze: Toggle Status Bar Token Count"
      }
    ],
    "keybindings": [
      {
        "command": "tokensqueeze.compress",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "editorHasSelection"
      },
      {
        "command": "tokensqueeze.explain",
        "key": "ctrl+shift+alt+s",
        "mac": "cmd+shift+alt+s",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "TokenSqueeze",
      "properties": {
        "tokensqueeze.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python interpreter used to run `python -m tokensqueeze.cli`."
        },
        "tokensqueeze.strategy": {
          "type": "string",
          "enum": ["auto", "sns", "llmlingua2", "gist"],
          "default": "auto",
          "description": "Compression strategy."
        },
        "tokensqueeze.encoding": {
          "type": "string",
          "default": "cl100k_base",
          "description": "Tokenizer encoding for token counts."
        },
        "tokensqueeze.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show selected-text token count in the status bar."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
